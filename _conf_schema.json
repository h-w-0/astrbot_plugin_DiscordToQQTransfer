      },
      "timeout_seconds": {
        "description": "翻译超时时间（秒）",
        "type": "int",
        "default": 30,
        "slider": {
          "min": 3,
          "max": 120,
          "step": 1
        }
      },
      "system_prompt": {
        "description": "翻译指令模板。可用占位符：{source_text}、{target_language}、{source_language}。",
